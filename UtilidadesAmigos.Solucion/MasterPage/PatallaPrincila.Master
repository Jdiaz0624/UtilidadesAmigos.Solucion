<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PatallaPrincila.master.cs" Inherits="UtilidadesAmigos.Solucion.MasterPage.PatallaPrincila" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">

    <!-- *** ESTE ES EL QUE FALTABA *** -->
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <title>Utilidades Futuro Seguros</title>

    <!-- Bootstrap moderno -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome moderno -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet" />

    <!-- jQuery (NECESARIO PARA EL MENÚ) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
       /* ================================
   LAYOUT GENERAL
================================ */
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
}

#wrapper {
    width: 100%;
    display: flex;
    min-height: 100vh;
}

#page-content-wrapper {
    width: 100%;
    flex-grow: 1;
    background-color: #f8f9fa;
}

/* ================================
   SIDEBAR
================================ */
#sidebar-wrapper {
    min-height: 100vh;
    background: #212529;
    color: white;
    padding: 15px;
    width: 260px;
    flex-shrink: 0;
}

#sidebar-wrapper .sidebar-heading {
    font-size: 1.2rem;
    font-weight: bold;
    padding: 10px 0;
}

/* ================================
   MENÚ PRINCIPAL
================================ */
.menu {
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.menu > li > a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    color: white !important;
    text-decoration: none !important;
    border-radius: 4px;
    background: rgba(255,255,255,0.05);
}

.menu > li > a:hover {
    background: rgba(255,255,255,0.15);
    text-decoration: none !important;
}

/* Quitar línea debajo del texto */
.menu a, .menu a:hover, .menu a:focus {
    text-decoration: none !important;
    border-bottom: none !important;
}

/* Submenús ocultos por defecto */
.menu li ul {
    display: none;
    padding-left: 0;
}

/* Estilo de los items del submenú */
.menu li ul li a,
.nav-link.text-light {
    display: block;
    padding: 8px 12px;
    color: #e9ecef !important;
    text-decoration: none !important;
    border-radius: 4px;
}

.menu li ul li a:hover {
    background: rgba(255,255,255,0.1);
}

/* ================================
   NAVBAR
================================ */
.nav-user-img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
}

/* ================================
   SIDEBAR TOGGLE
================================ */
#wrapper.toggled #sidebar-wrapper {
    margin-left: -260px;
    transition: all 0.3s ease;
}

#sidebar-wrapper {
    transition: all 0.3s ease;
}

/* ================================
   ESPACIADO ENTRE INICIO Y MÓDULOS
================================ */
.menu li.inicio {
    margin-bottom: 15px; /* ajusta el valor según lo que quieras */
}


/* ================================
   RESPONSIVE SIDEBAR
================================ */
@media (max-width: 768px) {
    #sidebar-wrapper {
        margin-left: -260px; /* oculta el sidebar */
    }

    #wrapper.toggled #sidebar-wrapper {
        margin-left: 0; /* lo muestra si se activa el toggle */
    }
}



    </style>

    <script>
        $(document).ready(function () {

            $('.menu > li > a').click(function (e) {
                e.preventDefault();
            });

            $('.menu li').has('ul').children('a').click(function () {

                let parentLi = $(this).parent('li');

                if (parentLi.hasClass('activado')) {
                    parentLi.removeClass('activado');
                    parentLi.children('ul').slideUp();
                } else {
                    $('.menu li ul').slideUp();
                    $('.menu li').removeClass('activado');
                    parentLi.addClass('activado');
                    parentLi.children('ul').slideDown();
                }
            });

        });
    </script>

</head>

<body>

