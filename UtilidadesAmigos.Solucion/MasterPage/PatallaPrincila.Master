                                    CssClass="nav-link text-danger"
                                    Text="🔄 Cambio de Intermediario"
                                    ToolTip="Cambiar Intermediario a Póliza"
                                    OnClick="LinkCambioIntermediario_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkCambioCliente" runat="server"
                                    CssClass="nav-link text-danger"
                                    Text="👤 Cambio de Cliente"
                                    ToolTip="Cambiar Cliente a Póliza"
                                    OnClick="LinkCambioCliente_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkModificarDatosCliente" runat="server"
                                    CssClass="nav-link text-danger"
                                    Text="✏️ Modificar Cliente"
                                    ToolTip="Modificar Cliente"
                                    OnClick="LinkModificarDatosCliente_Click" />
                            </li>
                        </ul>
                    </li>

                    <!-- MÓDULO DE MANTENIMIENTO -->
                    <li id="DivModuloMantenimiento" runat="server" visible="true" class="sb-module">
                        <div class="sb-module-header">
                            <div class="sb-module-header-left">
                                <div class="sb-module-icon"><i class="fa fa-wrench"></i></div>
                                <span class="sb-module-header-label">Mantenimiento</span>
                            </div>
                            <i class="fa fa-chevron-down sb-module-chevron"></i>
                        </div>
                        <ul class="sb-sub">
                            <li>
                                <asp:LinkButton ID="LinkClientes" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="👤 Clientes"
                                    ToolTip="Mantenimiento de Clientes"
                                    OnClick="LinkClientes_Click1" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkIntermediariosSupervisores" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🤝 Intermediarios / Supervisores"
                                    ToolTip="Mantenimiento de Intermediarios y Supervisores"
                                    OnClick="LinkIntermediariosSupervisores_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkOficinas" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🏢 Oficinas"
                                    ToolTip="Mantenimiento de Oficinas"
                                    OnClick="linkOficinas_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkDepartamentos" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="📂 Departamentos"
                                    ToolTip="Mantenimiento de Departamentos"
                                    OnClick="linkDeprtamentos_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkEmpleados" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="👥 Empleados"
                                    ToolTip="Mantenimiento de Empleados"
                                    OnClick="linkEmpleados_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkInventario" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="📦 Inventario"
                                    ToolTip="Mantenimiento de Inventario"
                                    OnClick="linkInventario_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkDependientes" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="👨‍👩‍👧 Dependientes"
                                    ToolTip="Mantenimiento de Dependientes"
                                    OnClick="LinkDependientes_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkPorcientoComision" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="💹 Porciento de Comisión"
                                    ToolTip="Mantenimiento de Porciento de Comisiones por Defecto"
                                    OnClick="LinkMantenimientoPorcientoComisionPorDefecto_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkMonedas" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="💱 Monedas"
                                    ToolTip="Mantenimiento de Monedas"
                                    OnClick="LinkMantenimientoMonedas_Click" />
                            </li>
                        </ul>
                    </li>

                    <div class="sb-section-label">Sistema</div>

                    <!-- MÓDULO DE SEGURIDAD -->
                    <li id="DivModuloSeguridad" runat="server" visible="true" class="sb-module">
                        <div class="sb-module-header">
                            <div class="sb-module-header-left">
                                <div class="sb-module-icon"><i class="fa fa-unlock-alt"></i></div>
                                <span class="sb-module-header-label">Seguridad</span>
                            </div>
                            <i class="fa fa-chevron-down sb-module-chevron"></i>
                        </div>
                        <ul class="sb-sub">
                            <li>
                                <asp:LinkButton ID="LinkUsuarios" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="👤 Usuarios"
                                    ToolTip="Mantenimiento de Usuarios"
                                    OnClick="linkUsuarios_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkPerfilesUsuarios" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🧩 Perfiles de Usuarios"
                                    ToolTip="Mantenimiento de Perfiles de Usuarios"
                                    OnClick="linkPerfilesUsuarios_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkClaveSeguridad" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🔑 Clave de Seguridad"
                                    ToolTip="Configurar Clave de Seguridad"
                                    OnClick="linkClaveSeguridad_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkConfiguracionCorreos" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="📧 Configuración de Correos"
                                    ToolTip="Configuración de Correos"
                                    OnClick="LinkCorreosEmisoresProcesos_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkMovimientoUsuarios" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🔄 Movimiento de Usuario"
                                    ToolTip="Movimientos de Usuarios"
                                    OnClick="linkMovimientoUsuarios_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkTarjetaAcceso" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="💳 Tarjetas de Acceso"
                                    ToolTip="Asignación de Tarjetas de Acceso"
                                    OnClick="linkTarjetasAccesos_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkModulos" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="📂 Módulos"
                                    ToolTip="Mantenimiento de Módulos"
                                    OnClick="linkOpcionMenu_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkPantallas" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🖥️ Pantallas"
                                    ToolTip="Mantenimiento de Pantallas"
                                    OnClick="linkOpcion_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkOpciones" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="⚙️ Opciones"
                                    ToolTip="Mantenimiento de Opciones"
                                    OnClick="linkBotones_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkPermisoUsuarios" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🛡️ Permiso de Usuarios"
                                    ToolTip="Mantenimiento de Permiso de Usuarios"
                                    OnClick="linkPermisoUsuarios_Click" />
                            </li>
                            <li>
                                <asp:LinkButton ID="LinkCredencialesBD" runat="server"
                                    CssClass="nav-link text-light"
                                    Text="🔐 Credenciales de BD"
                                    ToolTip="Credenciales de Bases de Datos"
                                    OnClick="LinkCredencialesBD_Click" />
                            </li>
                        </ul>
                    </li>

                    <!-- Cerrar Sesión -->
                    <li class="sb-root-item danger">
                        <asp:LinkButton ID="linkCerrarCesion" runat="server"
                            CssClass="btn btn-outline-danger w-100 text-start"
                            ToolTip="Cerrar Sesión"
                            OnClick="linkCerrarCesion_Click"
                            OnClientClick="return confirm('¿Quieres Cerrar Sesión?');">
                            <i class="fa fa-sign-out-alt me-2"></i> Cerrar Sesión
                        </asp:LinkButton>
                    </li>

                </ul>
            </div>
        </div>

        <!-- ═══════════════════════════════════════
             CONTENIDO PRINCIPAL
        ═══════════════════════════════════════ -->
        <div id="page-content-wrapper">

            <nav class="navbar-sistema">
                <button class="btn" id="menu-toggle" type="button">
                    <i class="fa fa-bars"></i>
                </button>

                <div class="nb-avatar-wrap">
                    <img src="https://www.svgrepo.com/show/384670/account-avatar-profile-user.svg"
                         class="nav-user-img" />
                    <span class="nb-online-dot"></span>
                </div>

                <div class="nb-user-info">
                    <asp:Label ID="lbUsuarioConectado" runat="server" CssClass="nb-user-name" />
                    <asp:Label ID="lbOficinaUsuairoPantalla" runat="server" CssClass="nb-user-sub" />
                </div>

                <span class="nb-chip">
                    <i class="fa fa-shield-alt"></i>
                    Sistema
                </span>

                <!-- Switch modo oscuro: un solo checkbox controla toda la paleta -->
                <label class="theme-toggle" id="themeToggle" title="Cambiar tema">
                    <span class="theme-toggle-label" id="themeLabel">Modo oscuro</span>
                    <input type="checkbox" id="chkModoOscuro" />
                </label>
            </nav>

            <div class="contenido">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
            </div>

        </div>

    </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
