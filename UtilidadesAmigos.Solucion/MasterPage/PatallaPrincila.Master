<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PatallaPrincila.master.cs" Inherits="UtilidadesAmigos.Solucion.MasterPage.PatallaPrincila" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <title>Utilidades Futuro Seguros</title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
/* ══════════════════════════════════════════════════
   TOKENS — paleta propia "Futuro" (azul institucional)
   NOTA: paleta distinta a DSSeguros, solo se copió la
   estructura/mecánica del menú y el modo oscuro.
══════════════════════════════════════════════════ */
:root {
    --sidebar-w:      272px;
    --sidebar-bg:     #0c2340;      /* azul marino institucional */
    --sidebar-bg-2:   #0f2b4d;
    --divider:        rgba(255,255,255,0.08);
    --text-label:     rgba(255,255,255,0.35);
    --text-item:      rgba(255,255,255,0.78);
    --text-hover:     #ffffff;
    --accent:         #2E9CCA;      /* azul cielo institucional */
    --accent-light:   #6cc5e8;
    --accent-dim:     rgba(46,156,202,0.12);
    --accent-dim2:    rgba(46,156,202,0.20);
    --danger:         #e5484d;
    --danger-dim:     rgba(229,72,77,0.12);
    --navbar-bg:      #ffffff;
    --navbar-border:  #e5e7eb;
    --content-bg:     #f1f5f9;
    --transition:     0.18s ease;
    --sub-indent:     16px;
    --radius:         10px;
}

/* ── MODO OSCURO (un solo interruptor controla toda la paleta) ── */
body.dark-mode {
    --sidebar-bg:     #071526;
    --sidebar-bg-2:   #09192e;
    --divider:        rgba(255,255,255,0.06);
    --navbar-bg:      #0b1c30;
    --navbar-border:  rgba(46,156,202,0.15);
    --content-bg:     #060f1c;
    --nb-name-color:  #e2e8f0;
    --nb-sub-color:   #94a3b8;
}

body.dark-mode .navbar-sistema {
    background: var(--navbar-bg) !important;
    border-bottom-color: var(--navbar-border) !important;
    box-shadow: 0 1px 12px rgba(0,0,0,0.35) !important;
}

body.dark-mode .contenido,
body.dark-mode #page-content-wrapper {
    background: var(--content-bg);
}

body.dark-mode .nb-user-name { color: var(--nb-name-color) !important; }
body.dark-mode .nb-user-sub  { color: var(--nb-sub-color) !important; }

body.dark-mode #btnToggleMenu {
    border-color: rgba(46,156,202,0.3) !important;
    color: var(--accent) !important;
    background: rgba(46,156,202,0.06) !important;
}

body.dark-mode .nb-chip {
    background: rgba(46,156,202,0.12) !important;
    border-color: rgba(46,156,202,0.25) !important;
    color: var(--accent-light) !important;
}

body.dark-mode .nb-online-dot { border-color: var(--navbar-bg) !important; }

*, *::before, *::after { box-sizing: border-box; }

body {
    margin: 0;
    font-family: 'Inter', 'Roboto', sans-serif;
    background: var(--content-bg);
    overflow-x: hidden;
    transition: background .3s;
}

/* ══════════════════════════════════════════════════
   LAYOUT
══════════════════════════════════════════════════ */
#wrapper {
    display: flex;
    min-height: 100vh;
}

/* ══════════════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════════════ */
#sidebar-wrapper {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    background: var(--sidebar-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 100;
    transition: transform 0.28s cubic-bezier(.4,0,.2,1), background .3s;
    border-right: 1px solid rgba(46,156,202,0.10);
}

/* ── LOGO ── */
.sb-logo {
    padding: 18px 18px 16px;
    border-bottom: 1px solid var(--divider);
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
    background: rgba(0,0,0,0.15);
}

.sb-logo-img-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
}

.sb-logo-img-wrap img {
    max-height: 46px;
    max-width: 210px;
    object-fit: contain;
    border-radius: 6px;
    background: #fff;
    padding: 4px 6px;
}

/* ── ÁREA SCROLLABLE ── */
.sb-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(46,156,202,0.18) transparent;
    padding-bottom: 20px;
}

.sb-scroll::-webkit-scrollbar { width: 3px; }
.sb-scroll::-webkit-scrollbar-track { background: transparent; }
.sb-scroll::-webkit-scrollbar-thumb {
    background: rgba(46,156,202,0.20);
    border-radius: 3px;
}

/* ══════════════════════════════════════════════════
   MENÚ
══════════════════════════════════════════════════ */
.sb-nav { list-style: none; margin: 0; padding: 8px 0 0; }

/* ── Módulo contenedor ── */
.sb-module {
    margin: 0 10px 2px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid transparent;
    transition: border-color .2s;
}

.sb-module.open {
    border-color: rgba(46,156,202,0.18);
    background: rgba(46,156,202,0.03);
}

/* ── Encabezado del módulo ── */
.sb-module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    height: 42px;
    cursor: pointer;
    user-select: none;
    transition: background var(--transition);
    border-radius: 8px;
    gap: 8px;
}

.sb-module-header:hover {
    background: rgba(255,255,255,0.05);
}

.sb-module.open .sb-module-header {
    background: rgba(46,156,202,0.08);
    border-radius: 8px 8px 0 0;
}

.sb-module-header-left {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
}

.sb-module-icon {
    width: 28px; height: 28px;
    border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.45);
    transition: background .2s, color .2s;
}

.sb-module.open .sb-module-icon {
    background: var(--accent-dim);
    color: var(--accent-light);
}

.sb-module-header-label {
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255,255,255,0.86);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .2s;
}

.sb-module.open .sb-module-header-label { color: #ffffff; }

/* Chevron */
.sb-module-chevron {
    font-size: 9px;
    color: rgba(255,255,255,0.28);
    transition: transform 0.22s ease, color 0.18s;
    flex-shrink: 0;
}

.sb-module.open .sb-module-chevron {
    transform: rotate(180deg);
    color: var(--accent-light);
}

/* ── Sub-lista ── */
.sb-sub {
    display: none;
    list-style: none;
    margin: 0;
    padding: 4px 0 6px;
}

.sb-sub li { margin: 0 6px 1px; }

/* Links (asp:LinkButton renderiza <a>) */
.sb-sub li a.nav-link,
.nav-link.text-light,
.nav-link.text-danger {
    display: flex !important;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 0 10px 0 calc(10px + var(--sub-indent)) !important;
    height: 36px;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--text-item) !important;
    background: transparent;
    border: none;
    text-align: left;
    text-decoration: none !important;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background var(--transition), color var(--transition), padding-left var(--transition);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-radius: 6px;
}

.sb-sub li a.nav-link::before {
    content: '';
    display: inline-block;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
    flex-shrink: 0;
    transition: background .2s, transform .2s;
}

.sb-sub li a.nav-link:hover {
    background: rgba(46,156,202,0.09);
    color: #ffffff !important;
    padding-left: calc(10px + var(--sub-indent) + 4px) !important;
}

.sb-sub li a.nav-link:hover::before {
    background: var(--accent-light);
    transform: scale(1.4);
}

/* Ítems críticos (antes text-danger fw-bold) */
.sb-sub li a.nav-link.text-danger {
    color: #ff8b90 !important;
    font-weight: 600;
}

.sb-sub li a.nav-link.text-danger::before {
    background: rgba(229,72,77,0.5);
}

.sb-sub li a.nav-link.text-danger:hover {
    background: var(--danger-dim);
    color: #ffb1b4 !important;
}

.sb-sub li a.nav-link.text-danger:hover::before {
    background: var(--danger);
}

/* ── ÍTEMS RAÍZ (Inicio, Cerrar Sesión) ── */
.sb-root-item { margin: 0 10px 2px; }

.sb-root-item a.btn {
    display: flex !important;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 0 14px;
    height: 42px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
}

.sb-root-item .btn-outline-info {
    color: var(--accent-light) !important;
    background: var(--accent-dim);
    border: 1px solid rgba(46,156,202,0.35) !important;
}

.sb-root-item .btn-outline-info:hover {
    background: var(--accent-dim2);
    border-color: var(--accent) !important;
    color: #ffffff !important;
}

/* Cerrar Sesión */
.sb-root-item.danger {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--divider);
}

.sb-root-item .btn-outline-danger {
    color: #ff9498 !important;
    background: transparent;
    border: 1px solid rgba(229,72,77,0.4) !important;
}

.sb-root-item .btn-outline-danger:hover {
    background: var(--danger-dim);
    border-color: var(--danger) !important;
    color: #ffb1b4 !important;
}

/* ── SEPARADOR DE SECCIÓN ── */
.sb-section-label {
    padding: 14px 20px 6px;
    font-size: 9.5px;
    font-weight: 700;
    color: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
}

/* ══════════════════════════════════════════════════
   NAVBAR SUPERIOR
══════════════════════════════════════════════════ */
#page-content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--content-bg);
    transition: background .3s;
}

.navbar-sistema {
    background: var(--navbar-bg);
    padding: 0 22px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--navbar-border);
    box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    position: sticky;
    top: 0;
    z-index: 90;
    flex-shrink: 0;
    transition: background .3s, border-color .3s, box-shadow .3s;
}

/* Botón hamburguesa (móvil) */
#menu-toggle {
    width: 34px; height: 34px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: #6b7280;
    transition: all var(--transition);
    flex-shrink: 0;
    padding: 0;
}

#menu-toggle:hover {
    background: #f9fafb;
    border-color: var(--accent);
    color: var(--accent);
}

/* Avatar */
.nb-avatar-wrap { position: relative; flex-shrink: 0; }

.nav-user-img {
    width: 36px; height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    flex-shrink: 0;
    display: block;
}

.nb-online-dot {
    position: absolute;
    bottom: 1px; right: 1px;
    width: 9px; height: 9px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid #fff;
    transition: border-color .3s;
}

/* Info usuario */
.nb-user-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }

#lbUsuarioConectado.nb-user-name {
    font-size: 13.5px;
    font-weight: 600;
    color: #111827;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .3s;
}

#lbOficinaUsuairoPantalla.nb-user-sub {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .3s;
}

/* Chip navbar */
.nb-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background: var(--accent-dim);
    border: 1px solid rgba(46,156,202,0.25);
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background .3s, border-color .3s;
}

@media (max-width: 600px) { .nb-chip { display: none; } }

/* ── SWITCH MODO OSCURO (un solo checkbox real) ── */
.theme-toggle {
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    user-select: none;
    flex-shrink: 0;
}

.theme-toggle-label {
    font-size: 11px;
    font-weight: 500;
    color: #9ca3af;
    transition: color .3s;
    white-space: nowrap;
}

body.dark-mode .theme-toggle-label { color: #64748b; }

.theme-toggle input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 34px; height: 18px;
    background: #d1d5db;
    border-radius: 18px;
    position: relative;
    margin: 0;
    cursor: pointer;
    transition: background .3s;
    flex-shrink: 0;
    outline: none;
}

.theme-toggle input[type="checkbox"]::before {
    content: '';
    position: absolute;
    width: 12px; height: 12px;
    background: #fff;
    border-radius: 50%;
    top: 3px; left: 3px;
    transition: left .25s;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
}

.theme-toggle input[type="checkbox"]:checked {
    background: var(--accent);
}

.theme-toggle input[type="checkbox"]:checked::before {
    left: 19px;
}

@media (max-width: 480px) { .theme-toggle-label { display: none; } }

/* ══════════════════════════════════════════════════
   CONTENIDO
══════════════════════════════════════════════════ */
.contenido {
    padding: 22px;
    flex: 1;
    background: var(--content-bg);
    transition: background .3s;
}

/* ══════════════════════════════════════════════════
   OVERLAY DE CARGA
══════════════════════════════════════════════════ */
#loadingOverlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.55);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(4px);
}

.loader-ring { position: relative; width: 72px; height: 72px; }

.loader-ring::before {
    content: '';
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 3px solid transparent;
    border-top-color: var(--accent);
    border-right-color: rgba(46,156,202,0.3);
    animation: spinOuter 1s linear infinite;
}

.loader-ring::after {
    content: '';
    position: absolute; inset: 10px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-bottom-color: rgba(46,156,202,0.5);
    animation: spinOuter 0.7s linear infinite reverse;
}

.loader-dot {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulseDot 1s ease-in-out infinite;
}

@keyframes spinOuter { to { transform: rotate(360deg); } }
@keyframes pulseDot {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 1; }
    50%      { transform: translate(-50%,-50%) scale(0.5); opacity: 0.4; }
}

.loader-bar {
    width: 120px; height: 2px;
    background: rgba(46,156,202,0.15);
    border-radius: 2px;
    margin-top: 22px;
    overflow: hidden;
}

.loader-bar::after {
    content: '';
    display: block;
    width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: barSlide 1.3s ease-in-out infinite;
}

@keyframes barSlide { 0% { margin-left: -50%; } 100% { margin-left: 150%; } }

/* ══════════════════════════════════════════════════
   OVERLAY MÓVIL DEL SIDEBAR
══════════════════════════════════════════════════ */
#sidebarOverlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 1040;
    backdrop-filter: blur(2px);
}

#sidebarOverlay.visible { display: block; }

/* ══════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════ */
@media (max-width: 768px) {
    #sidebar-wrapper {
        position: fixed;
        top: 0; left: 0;
        height: 100%;
        z-index: 1050;
        transform: translateX(-100%);
    }

    #wrapper.toggled #sidebar-wrapper { transform: translateX(0); }

    .contenido, .container-fluid.py-4 { padding: 14px !important; }
    .navbar-sistema { padding: 0 14px; }
}

@media (min-width: 769px) {
    #wrapper.toggled #sidebar-wrapper {
        transform: translateX(calc(-1 * var(--sidebar-w)));
        margin-left: calc(-1 * var(--sidebar-w));
    }
}

@media (max-width: 480px) {
    :root { --sidebar-w: 256px; }
    .contenido { padding: 10px; }
}
    </style>

    <script>
        function mostrarOverlay() {
            var o = document.getElementById('loadingOverlay');
            if (!o) return;
            o.style.display = 'flex';
            setTimeout(function () { o.style.opacity = '1'; }, 10);
        }

        function ocultarOverlay() {
            var o = document.getElementById('loadingOverlay');
            if (!o) return;
            o.style.opacity = '0';
            setTimeout(function () { o.style.display = 'none'; }, 400);
        }

        window.addEventListener('load', ocultarOverlay);

        $(document).ready(function () {

            /* ── Acordeón del menú (encabezados .sb-module-header) ── */
            $('.sb-module-header').on('click', function () {
                var $module = $(this).closest('.sb-module');
                var $sub = $module.find('> .sb-sub');
                var isOpen = $module.hasClass('open');

                $('.sb-module.open').not($module).each(function () {
                    $(this).removeClass('open').find('> .sb-sub').stop(true).slideUp(200);
                });

                if (isOpen) {
                    $module.removeClass('open');
                    $sub.stop(true).slideUp(200);
                } else {
                    $module.addClass('open');
                    $sub.stop(true).slideDown(220);
                }
            });

            /* ── Toggle sidebar (desktop colapsa, móvil desliza con overlay) ── */
            $("#menu-toggle").on('click', function (e) {
                e.preventDefault();
                $("#wrapper").toggleClass("toggled");

                if ($(window).width() <= 768) {
                    $('#sidebarOverlay').toggleClass('visible', $("#wrapper").hasClass("toggled"));
                    $('body').css('overflow', $("#wrapper").hasClass("toggled") ? 'hidden' : '');
                }
            });

            $('#sidebarOverlay').on('click', function () {
                $("#wrapper").removeClass("toggled");
                $(this).removeClass('visible');
                $('body').css('overflow', '');
            });

            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    $("#wrapper").removeClass("toggled");
                    $('#sidebarOverlay').removeClass('visible');
                    $('body').css('overflow', '');
                }
            });

            $(window).on('resize', function () {
                if ($(window).width() > 768) {
                    $('#sidebarOverlay').removeClass('visible');
                    $('body').css('overflow', '');
                }
            });

            /* ── Overlay de carga al navegar dentro del sidebar ── */
            $('#sidebar-wrapper a, #sidebar-wrapper input[type="submit"]')
                .not('.sb-module-header, .sb-module-header *')
                .on('click', function () {
                    mostrarOverlay();
                    if ($(window).width() <= 768) {
                        setTimeout(function () {
                            $("#wrapper").removeClass("toggled");
                            $('#sidebarOverlay').removeClass('visible');
                            $('body').css('overflow', '');
                        }, 100);
                    }
                });

            /* ── Cerrar sidebar al navegar (móvil) ── */
            $('.sb-sub a').on('click', function () {
                if ($(window).width() <= 768) {
                    setTimeout(function () {
                        $("#wrapper").removeClass("toggled");
                        $('#sidebarOverlay').removeClass('visible');
                        $('body').css('overflow', '');
                    }, 100);
                }
            });

            /* ── MODO OSCURO: un solo checkbox controla toda la paleta ── */
            function aplicarTema(oscuro) {
                $('body').toggleClass('dark-mode', oscuro);
                $('#themeLabel').text(oscuro ? 'Modo claro' : 'Modo oscuro');
                $('#chkModoOscuro').prop('checked', oscuro);
                localStorage.setItem('futuro_seguros_theme', oscuro ? 'dark' : 'light');
            }

            var temaGuardado = localStorage.getItem('futuro_seguros_theme') === 'dark';
            aplicarTema(temaGuardado);

            $('#chkModoOscuro').on('change', function () {
                aplicarTema($(this).is(':checked'));
            });

            $('#themeToggle').on('click', function (e) {
                if (e.target && e.target.id === 'chkModoOscuro') return;
                $('#chkModoOscuro').prop('checked', !$('#chkModoOscuro').is(':checked')).trigger('change');
            });

        });
    </script>

</head>

